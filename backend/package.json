{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API server for the MERN notes application",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "test": "mocha",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "chai": "^4.4.1",
    "eslint": "^8.57.0",
    "mocha": "^10.6.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
